{
  "name": "sami-severi-sjoberg-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio website for Sami-Severi Sjöberg",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve . -p 5500",
    "serve": "npx --yes serve . -p 5500",
    "lint:js": "eslint \"js/**/*.js\"",
    "lint:html": "html-validate \"*.html\"",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:html && npm run lint:css",
    "format:check": "prettier --check \"js/**/*.js\" \"scripts/**/*.mjs\" \"eslint.config.js\" \"package.json\" \"README.md\" \".github/**/*.{yml,yaml}\" \".*.json\" \".vscode/*.json\"",
    "format": "prettier --write \"js/**/*.js\" \"scripts/**/*.mjs\" \"eslint.config.js\" \"package.json\" \"README.md\" \".github/**/*.{yml,yaml}\" \".*.json\" \".vscode/*.json\"",
    "check:links": "node scripts/check-links.mjs",
    "validate": "npm run lint:js && npm run lint:html && npm run lint:css && npm run format:check && npm run check:links"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "html-validate": "^9.5.2",
    "prettier": "^3.5.3",
    "stylelint": "^16.16.0",
    "stylelint-config-standard": "^37.0.0"
  }
}
